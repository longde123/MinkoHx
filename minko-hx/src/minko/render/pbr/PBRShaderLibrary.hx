package minko.render.pbr;

/**
 * GLSL sources for the PBR render paths.
 *
 * Sources intentionally do not contain "#version": minko Shader prepends the
 * backend-specific version (100 for WebGL, 120 for HL/OpenGL).
 */
class PBRShaderLibrary {
    public static function forwardVertex():String {
        return [
            "attribute vec3 position;",
            "attribute vec3 normal;",
            "attribute vec2 uv;",
            "uniform mat4 modelMatrix;",
            "uniform mat4 viewMatrix;",
            "uniform mat4 projectionMatrix;",
            "uniform mat4 normalMatrix;",
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "void main() {",
            "    vec4 world = modelMatrix * vec4(position, 1.0);",
            "    vWorldPosition = world.xyz;",
            "    vNormal = normalize((normalMatrix * vec4(normal, 0.0)).xyz);",
            "    vUV = uv;",
            "    gl_Position = projectionMatrix * viewMatrix * world;",
            "}"
        ].join("\n");
    }

    /**
     * BRDF helpers shared by the forward and deferred lighting shaders.
     * Kept as one chunk so both paths evaluate light identically.
     */
    public static function brdfFunctions():Array<String> {
        return [
            "const float PI = 3.14159265359;",
            "float distributionGGX(vec3 N, vec3 H, float roughness) {",
            "    float a = roughness * roughness;",
            "    float a2 = a * a;",
            "    float NdotH = max(dot(N, H), 0.0);",
            "    float NdotH2 = NdotH * NdotH;",
            "    float denom = NdotH2 * (a2 - 1.0) + 1.0;",
            "    return a2 / max(PI * denom * denom, 1e-4);",
            "}",
            "float geometrySchlickGGX(float NdotV, float roughness) {",
            "    float r = roughness + 1.0;",
            "    float k = (r * r) / 8.0;",
            "    return NdotV / (NdotV * (1.0 - k) + k);",
            "}",
            "float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {",
            "    float NdotV = max(dot(N, V), 0.0);",
            "    float NdotL = max(dot(N, L), 0.0);",
            "    return geometrySchlickGGX(NdotV, roughness) * geometrySchlickGGX(NdotL, roughness);",
            "}",
            "vec3 fresnelSchlick(float cosTheta, vec3 F0) {",
            "    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);",
            "}",
            "vec3 evaluateLight(vec3 N, vec3 V, vec3 L, vec3 radiance, vec3 F0, vec3 albedo, float metallic, float roughness) {",
            "    vec3 H = normalize(V + L);",
            "    float NDF = distributionGGX(N, H, roughness);",
            "    float G = geometrySmith(N, V, L, roughness);",
            "    vec3 F = fresnelSchlick(max(dot(H, V), 0.0), F0);",
            "    vec3 specular = (NDF * G * F) / max(4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0), 1e-4);",
            "    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);",
            "    float NdotL = max(dot(N, L), 0.0);",
            "    return (kD * albedo / PI + specular) * radiance * NdotL;",
            "}"
        ];
    }

    public static function forwardFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "uniform vec3 uCameraPosition;",
            "uniform vec4 uBaseColor;",
            "uniform sampler2D uBaseColorMap;",
            "uniform float uHasBaseColorMap;",
            "uniform float uMetallic;",
            "uniform float uRoughness;",
            "uniform vec3 uEmissive;",
            "uniform vec3 uAmbient;",
            "uniform vec3 uLightDirection;",
            "uniform vec3 uLightColor;",
            "uniform float uLightIntensity;",
            "uniform sampler2D uShadowMap;",
            "uniform mat4 uLightViewProjection;",
            "uniform float uHasShadowMap;",
            "uniform float uShadowTexelSize;",
            "uniform float uSoftShadows;",
            "uniform float uLightSize;",
            "uniform sampler2D uShadowMap0;",
            "uniform sampler2D uShadowMap1;",
            "uniform sampler2D uShadowMap2;",
            "uniform sampler2D uShadowMap3;",
            "uniform mat4 uShadowMatrix0;",
            "uniform mat4 uShadowMatrix1;",
            "uniform mat4 uShadowMatrix2;",
            "uniform mat4 uShadowMatrix3;",
            "uniform vec4 uCascadeSplits;",
            "uniform float uCascadeCount;",
            "uniform sampler2D uSpotShadowAtlas;",
            "uniform mat4 uSpotShadowMatrix;",
            "uniform float uSpotShadowLightIndex;",
            "uniform float uSpotShadowCell;",
            "uniform float uSpotShadowCount;",
            "uniform float uSpotShadowLightIndex1;",
            "uniform float uSpotShadowCell1;",
            "uniform mat4 uSpotShadowMatrix1;",
            "uniform float uHasSpotShadow;",
            "uniform sampler2D uPointShadowAtlas;",
            "uniform mat4 uPointShadowMatrix0;",
            "uniform mat4 uPointShadowMatrix1;",
            "uniform mat4 uPointShadowMatrix2;",
            "uniform mat4 uPointShadowMatrix3;",
            "uniform mat4 uPointShadowMatrix4;",
            "uniform mat4 uPointShadowMatrix5;",
            "uniform mat4 uPointShadowMatrix6;",
            "uniform mat4 uPointShadowMatrix7;",
            "uniform mat4 uPointShadowMatrix8;",
            "uniform mat4 uPointShadowMatrix9;",
            "uniform mat4 uPointShadowMatrix10;",
            "uniform mat4 uPointShadowMatrix11;",
            "uniform float uPointShadowCount;",
            "uniform float uPointShadowLightIndex1;",
            "uniform vec3 uPointShadowPosition1;",
            "uniform float uPointShadowRange1;",
            "uniform vec3 uPointShadowPosition;",
            "uniform float uPointShadowRange;",
            "uniform float uPointShadowLightIndex;",
            "uniform float uHasPointShadow;",
            "uniform samplerCube uPointShadowCube;",
            "uniform samplerCube uPointShadowCube1;",
            "uniform float uHasPointShadowCube;",
            "uniform float uHasPointShadowCube1;",
            "#define MAX_POINT_LIGHTS 32",
            "uniform float uPointLightCount;",
            "uniform vec4 uPointLightPositions[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightColors[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightParams[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightDirections[MAX_POINT_LIGHTS];",
            "uniform sampler2D uLightTileMap;",
            "uniform float uHasLightTileMap;",
            "uniform vec2 uLightTileMapSize;",
            "uniform vec2 uTileSize;",
            "uniform float uTileMaxLights;"
        ].concat(brdfFunctions()).concat([
            "float shadowAt(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 uv = projected.xy * 0.5 + 0.5;",
            "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float radius = 1.0;",
            "    if (uSoftShadows > 0.5) {",
            "        float blockerSum = 0.0;",
            "        float blockers = 0.0;",
            "        for (int by = -2; by <= 2; ++by) {",
            "            for (int bx = -2; bx <= 2; ++bx) {",
            "                vec2 blockerUV = uv + vec2(float(bx), float(by)) * uShadowTexelSize;",
            "                if (blockerUV.x < 0.0 || blockerUV.x > 1.0 || blockerUV.y < 0.0 || blockerUV.y > 1.0) continue;",
            "                float occluder = texture2D(shadowMap, blockerUV).r;",
            "                if (depth - bias > occluder) {",
            "                    blockerSum += occluder;",
            "                    blockers += 1.0;",
            "                }",
            "            }",
            "        }",
            "        if (blockers > 0.5) {",
            "            float blockerDepth = blockerSum / blockers;",
            "            radius = clamp((depth - blockerDepth) * uLightSize * 100.0, 1.0, 8.0);",
            "        }",
            "    }",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = uv + vec2(float(x), float(y)) * uShadowTexelSize * radius;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {",
            "                result += 1.0;",
            "                continue;",
            "            }",
            "            float occluder = texture2D(shadowMap, sampleUV).r;",
            "            result += depth - bias > occluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float shadowAtAtlas(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap, vec2 cell, vec2 grid) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 localUV = projected.xy * 0.5 + 0.5;",
            "    if (localUV.x < 0.0 || localUV.x > 1.0 || localUV.y < 0.0 || localUV.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float radius = 1.0;",
            "    if (uSoftShadows > 0.5) {",
            "        float blockerSum = 0.0;",
            "        float blockers = 0.0;",
            "        for (int by = -2; by <= 2; ++by) {",
            "            for (int bx = -2; bx <= 2; ++bx) {",
            "                vec2 blockerUV = localUV + vec2(float(bx), float(by)) * uShadowTexelSize;",
            "                if (blockerUV.x < 0.0 || blockerUV.x > 1.0 || blockerUV.y < 0.0 || blockerUV.y > 1.0) continue;",
            "                float occluder = texture2D(shadowMap, (blockerUV + cell) / grid).r;",
            "                if (depth - bias > occluder) { blockerSum += occluder; blockers += 1.0; }",
            "            }",
            "        }",
            "        if (blockers > 0.5) {",
            "            float blockerDepth = blockerSum / blockers;",
            "            radius = clamp((depth - blockerDepth) * uLightSize * 100.0, 1.0, 8.0);",
            "        }",
            "    }",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = localUV + vec2(float(x), float(y)) * uShadowTexelSize * radius;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) { result += 1.0; continue; }",
            "            float occluder = texture2D(shadowMap, (sampleUV + cell) / grid).r;",
            "            result += depth - bias > occluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float shadowFactor(vec3 worldPosition) {",
            "    if (uCascadeCount > 0.5) {",
            "        float viewDepth = length(worldPosition - uCameraPosition);",
            "        if (viewDepth < uCascadeSplits.x) return shadowAt(worldPosition, uShadowMatrix0, uShadowMap0);",
            "        if (viewDepth < uCascadeSplits.y) return shadowAt(worldPosition, uShadowMatrix1, uShadowMap1);",
            "        if (viewDepth < uCascadeSplits.z) return shadowAt(worldPosition, uShadowMatrix2, uShadowMap2);",
            "        return shadowAt(worldPosition, uShadowMatrix3, uShadowMap3);",
            "    }",
            "    if (uHasShadowMap < 0.5) return 1.0;",
            "    return shadowAt(worldPosition, uLightViewProjection, uShadowMap);",
            "}",
            "float spotShadowFactor(vec3 worldPosition) {",
            "    if (uHasSpotShadow < 0.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix, uSpotShadowAtlas, vec2(uSpotShadowCell, 0.0), vec2(2.0, 1.0));",
            "}",
            "float spotShadowFactor1(vec3 worldPosition) {",
            "    if (uSpotShadowCount < 1.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix1, uSpotShadowAtlas, vec2(uSpotShadowCell1, 0.0), vec2(2.0, 1.0));",
            "}",
            "float pointShadowFactor(vec3 worldPosition) {",
            "    if (uHasPointShadow < 0.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition;",
            "    vec3 a = abs(direction);",
            "    vec2 cell;",
            "    mat4 matrix;",
            "    if (a.x >= a.y && a.x >= a.z) {",
            "        if (direction.x >= 0.0) { cell = vec2(0.0, 0.0); matrix = uPointShadowMatrix0; }",
            "        else { cell = vec2(1.0, 0.0); matrix = uPointShadowMatrix1; }",
            "    }",
            "    else if (a.y >= a.z) {",
            "        if (direction.y >= 0.0) { cell = vec2(2.0, 0.0); matrix = uPointShadowMatrix2; }",
            "        else { cell = vec2(0.0, 1.0); matrix = uPointShadowMatrix3; }",
            "    }",
            "    else {",
            "        if (direction.z >= 0.0) { cell = vec2(1.0, 1.0); matrix = uPointShadowMatrix4; }",
            "        else { cell = vec2(2.0, 1.0); matrix = uPointShadowMatrix5; }",
            "    }",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactor1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition1;",
            "    vec3 a = abs(direction);",
            "    int face = 0;",
            "    if (a.x >= a.y && a.x >= a.z) face = direction.x >= 0.0 ? 0 : 1;",
            "    else if (a.y >= a.z) face = direction.y >= 0.0 ? 2 : 3;",
            "    else face = direction.z >= 0.0 ? 4 : 5;",
            "    int cellIndex = 6 + face;",
            "    vec2 cell = vec2(mod(float(cellIndex), 4.0), floor(float(cellIndex) / 4.0));",
            "    mat4 matrix = uPointShadowMatrix6;",
            "    if (face == 1) matrix = uPointShadowMatrix7;",
            "    else if (face == 2) matrix = uPointShadowMatrix8;",
            "    else if (face == 3) matrix = uPointShadowMatrix9;",
            "    else if (face == 4) matrix = uPointShadowMatrix10;",
            "    else if (face == 5) matrix = uPointShadowMatrix11;",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactorCube(vec3 worldPosition) {",
            "    if (uHasPointShadowCube < 0.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition;",
            "    float normalized = length(toLight) / max(uPointShadowRange, 0.0001);",
            "    float stored = textureCube(uPointShadowCube, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "float pointShadowFactorCube1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition1;",
            "    float normalized = length(toLight) / max(uPointShadowRange1, 0.0001);",
            "    float stored = textureCube(uPointShadowCube1, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "void main() {",
            "    vec3 N = normalize(vNormal);",
            "    vec3 V = normalize(uCameraPosition - vWorldPosition);",
            "    vec3 albedo = uBaseColor.rgb;",
            "    if (uHasBaseColorMap > 0.5) {",
            "        albedo *= texture2D(uBaseColorMap, vUV).rgb;",
            "    }",
            "    vec3 F0 = mix(vec3(0.04), albedo, uMetallic);",
            "    vec3 color = vec3(0.0);",
            "    vec3 L = normalize(-uLightDirection);",
            "    vec3 radiance = uLightColor * uLightIntensity * shadowFactor(vWorldPosition);",
            "    color += evaluateLight(N, V, L, radiance, F0, albedo, uMetallic, uRoughness);",
            "    for (int i = 0; i < MAX_POINT_LIGHTS; ++i) {",
            "        if (uHasLightTileMap > 0.5) {",
            "            ivec2 tile = ivec2(gl_FragCoord.xy / uTileSize);",
            "            vec4 tileMask = texture2D(uLightTileMap, (vec2(tile) + 0.5) / uLightTileMapSize);",
            "            float packed;",
            "            if (i < 8) packed = tileMask.r;",
            "            else if (i < 16) packed = tileMask.g;",
            "            else if (i < 24) packed = tileMask.b;",
            "            else packed = tileMask.a;",
            "            int bitIndex = i - (i / 8) * 8;",
            "            float packed255 = floor(packed * 255.0 + 0.5);",
            "            float bitValue = mod(floor(packed255 / exp2(float(bitIndex))), 2.0);",
            "            if (bitValue < 0.5) continue;",
            "        }",
            "        if (i >= int(uPointLightCount)) break;",
            "        vec3 toLight = uPointLightPositions[i].xyz - vWorldPosition;",
            "        float distanceToLight = length(toLight);",
            "        vec3 lightDir = toLight / max(distanceToLight, 0.0001);",
            "        float range = uPointLightParams[i].x;",
            "        float intensity = uPointLightParams[i].y;",
            "        float attenuation = clamp(1.0 - distanceToLight / max(range, 0.0001), 0.0, 1.0);",
            "        attenuation = attenuation * attenuation / max(distanceToLight * distanceToLight, 0.0001);",
            "        if (uPointLightDirections[i].w > 0.5) {",
            "            vec3 spotDirection = normalize(-uPointLightDirections[i].xyz);",
            "            float theta = dot(lightDir, spotDirection);",
            "            float spot = clamp((theta - uPointLightParams[i].w) / max(uPointLightParams[i].z - uPointLightParams[i].w, 0.0001), 0.0, 1.0);",
            "            attenuation *= spot;",
            "        }",
            "        if (uSpotShadowCount > 0.5 && i == int(uSpotShadowLightIndex)) attenuation *= spotShadowFactor(vWorldPosition);
        if (uSpotShadowCount > 1.5 && i == int(uSpotShadowLightIndex1)) attenuation *= spotShadowFactor1(vWorldPosition);",
            "        if (uHasPointShadowCube > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactorCube(vWorldPosition);",
"            else if (uHasPointShadow > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactor(vWorldPosition);",
            "        if (uHasPointShadowCube1 > 0.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactorCube1(vWorldPosition);",
"        else if (uPointShadowCount > 1.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactor1(vWorldPosition);",
            "        color += evaluateLight(N, V, lightDir, uPointLightColors[i].xyz * intensity * attenuation, F0, albedo, uMetallic, uRoughness);",
            "    }",
            "    color += uEmissive + albedo * uAmbient;",
            "    gl_FragColor = vec4(color, uBaseColor.a);",
            "}"
        ]).join("\n");
    }

    public static function fullscreenVertex():String {
        return [
            "attribute vec2 position;",
            "attribute vec2 uv;",
            "varying vec2 vUV;",
            "void main() {",
            "    vUV = uv;",
            "    gl_Position = vec4(position, 0.0, 1.0);",
            "}"
        ].join("\n");
    }

    public static function tonemapFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uColorMap;",
            "uniform float uExposure;",
            "uniform float uGamma;",
            "vec3 reinhard(vec3 color) {",
            "    return color / (color + vec3(1.0));",
            "}",
            "void main() {",
            "    vec3 color = texture2D(uColorMap, vUV).rgb * uExposure;",
            "    color = reinhard(color);",
            "    color = pow(color, vec3(1.0 / max(uGamma, 0.0001)));",
            "    gl_FragColor = vec4(color, 1.0);",
            "}"
        ].join("\n");
    }

    /**
     * Deferred lighting evaluation.
     *
     * G-buffer layout (matches gbufferFragment):
     *   albedo.rgb  albedo (a unused)
     *   normal.rgb  encoded world normal, normal.a roughness
     *   emissive.rgb emissive, emissive.a metallic
     *
     * The view direction is rebuilt from the camera basis and UV. When a depth
     * texture is present, world position is reconstructed for point/spot lights
     * and directional shadows.
     */
    public static function deferredLightingFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uAlbedoMap;",
            "uniform sampler2D uNormalMap;",
            "uniform sampler2D uEmissiveMap;",
            "uniform sampler2D uAOMap;",
            "uniform float uHasAOMap;",
            "uniform sampler2D uDepthMap;",
            "uniform sampler2D uShadowMap;",
            "uniform vec3 uLightDirection;",
            "uniform vec3 uLightColor;",
            "uniform float uLightIntensity;",
            "uniform vec3 uAmbient;",
            "uniform vec3 uCameraRight;",
            "uniform vec3 uCameraUp;",
            "uniform vec3 uCameraForward;",
            "uniform vec3 uCameraPosition;",
            "uniform float uTanHalfFov;",
            "uniform float uAspect;",
            "uniform float uHasDepth;",
            "uniform float uHasShadowMap;",
            "uniform float uShadowTexelSize;",
            "uniform float uSoftShadows;",
            "uniform float uLightSize;",
            "uniform sampler2D uShadowMap0;",
            "uniform sampler2D uShadowMap1;",
            "uniform sampler2D uShadowMap2;",
            "uniform sampler2D uShadowMap3;",
            "uniform mat4 uShadowMatrix0;",
            "uniform mat4 uShadowMatrix1;",
            "uniform mat4 uShadowMatrix2;",
            "uniform mat4 uShadowMatrix3;",
            "uniform vec4 uCascadeSplits;",
            "uniform float uCascadeCount;",
            "uniform sampler2D uSpotShadowAtlas;",
            "uniform mat4 uSpotShadowMatrix;",
            "uniform float uSpotShadowLightIndex;",
            "uniform float uSpotShadowCell;",
            "uniform float uSpotShadowCount;",
            "uniform float uSpotShadowLightIndex1;",
            "uniform float uSpotShadowCell1;",
            "uniform mat4 uSpotShadowMatrix1;",
            "uniform float uHasSpotShadow;",
            "uniform sampler2D uPointShadowAtlas;",
            "uniform mat4 uPointShadowMatrix0;",
            "uniform mat4 uPointShadowMatrix1;",
            "uniform mat4 uPointShadowMatrix2;",
            "uniform mat4 uPointShadowMatrix3;",
            "uniform mat4 uPointShadowMatrix4;",
            "uniform mat4 uPointShadowMatrix5;",
            "uniform mat4 uPointShadowMatrix6;",
            "uniform mat4 uPointShadowMatrix7;",
            "uniform mat4 uPointShadowMatrix8;",
            "uniform mat4 uPointShadowMatrix9;",
            "uniform mat4 uPointShadowMatrix10;",
            "uniform mat4 uPointShadowMatrix11;",
            "uniform float uPointShadowCount;",
            "uniform float uPointShadowLightIndex1;",
            "uniform vec3 uPointShadowPosition1;",
            "uniform float uPointShadowRange1;",
            "uniform vec3 uPointShadowPosition;",
            "uniform float uPointShadowRange;",
            "uniform float uPointShadowLightIndex;",
            "uniform float uHasPointShadow;",
            "uniform samplerCube uPointShadowCube;",
            "uniform samplerCube uPointShadowCube1;",
            "uniform float uHasPointShadowCube;",
            "uniform float uHasPointShadowCube1;",
            "uniform mat4 uInverseViewProjection;",
            "uniform mat4 uLightViewProjection;",
            "#define MAX_POINT_LIGHTS 32",
            "uniform float uPointLightCount;",
            "uniform vec4 uPointLightPositions[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightColors[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightParams[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightDirections[MAX_POINT_LIGHTS];",
            "uniform sampler2D uLightTileMap;",
            "uniform float uHasLightTileMap;",
            "uniform vec2 uLightTileMapSize;",
            "uniform vec2 uTileSize;",
            "uniform float uTileMaxLights;"
        ].concat(brdfFunctions()).concat([
            "float shadowAt(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 uv = projected.xy * 0.5 + 0.5;",
            "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float radius = 1.0;",
            "    if (uSoftShadows > 0.5) {",
            "        float blockerSum = 0.0;",
            "        float blockers = 0.0;",
            "        for (int by = -2; by <= 2; ++by) {",
            "            for (int bx = -2; bx <= 2; ++bx) {",
            "                vec2 blockerUV = uv + vec2(float(bx), float(by)) * uShadowTexelSize;",
            "                if (blockerUV.x < 0.0 || blockerUV.x > 1.0 || blockerUV.y < 0.0 || blockerUV.y > 1.0) continue;",
            "                float occluder = texture2D(shadowMap, blockerUV).r;",
            "                if (depth - bias > occluder) {",
            "                    blockerSum += occluder;",
            "                    blockers += 1.0;",
            "                }",
            "            }",
            "        }",
            "        if (blockers > 0.5) {",
            "            float blockerDepth = blockerSum / blockers;",
            "            radius = clamp((depth - blockerDepth) * uLightSize * 100.0, 1.0, 8.0);",
            "        }",
            "    }",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = uv + vec2(float(x), float(y)) * uShadowTexelSize * radius;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {",
            "                result += 1.0;",
            "                continue;",
            "            }",
            "            float occluder = texture2D(shadowMap, sampleUV).r;",
            "            result += depth - bias > occluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float shadowAtAtlas(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap, vec2 cell, vec2 grid) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 localUV = projected.xy * 0.5 + 0.5;",
            "    if (localUV.x < 0.0 || localUV.x > 1.0 || localUV.y < 0.0 || localUV.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float radius = 1.0;",
            "    if (uSoftShadows > 0.5) {",
            "        float blockerSum = 0.0;",
            "        float blockers = 0.0;",
            "        for (int by = -2; by <= 2; ++by) {",
            "            for (int bx = -2; bx <= 2; ++bx) {",
            "                vec2 blockerUV = localUV + vec2(float(bx), float(by)) * uShadowTexelSize;",
            "                if (blockerUV.x < 0.0 || blockerUV.x > 1.0 || blockerUV.y < 0.0 || blockerUV.y > 1.0) continue;",
            "                float occluder = texture2D(shadowMap, (blockerUV + cell) / grid).r;",
            "                if (depth - bias > occluder) { blockerSum += occluder; blockers += 1.0; }",
            "            }",
            "        }",
            "        if (blockers > 0.5) {",
            "            float blockerDepth = blockerSum / blockers;",
            "            radius = clamp((depth - blockerDepth) * uLightSize * 100.0, 1.0, 8.0);",
            "        }",
            "    }",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = localUV + vec2(float(x), float(y)) * uShadowTexelSize * radius;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) { result += 1.0; continue; }",
            "            float occluder = texture2D(shadowMap, (sampleUV + cell) / grid).r;",
            "            result += depth - bias > occluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float shadowFactor(vec3 worldPosition) {",
            "    if (uCascadeCount > 0.5) {",
            "        float viewDepth = length(worldPosition - uCameraPosition);",
            "        if (viewDepth < uCascadeSplits.x) return shadowAt(worldPosition, uShadowMatrix0, uShadowMap0);",
            "        if (viewDepth < uCascadeSplits.y) return shadowAt(worldPosition, uShadowMatrix1, uShadowMap1);",
            "        if (viewDepth < uCascadeSplits.z) return shadowAt(worldPosition, uShadowMatrix2, uShadowMap2);",
            "        return shadowAt(worldPosition, uShadowMatrix3, uShadowMap3);",
            "    }",
            "    if (uHasShadowMap < 0.5) return 1.0;",
            "    return shadowAt(worldPosition, uLightViewProjection, uShadowMap);",
            "}",
            "float spotShadowFactor(vec3 worldPosition) {",
            "    if (uHasSpotShadow < 0.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix, uSpotShadowAtlas, vec2(uSpotShadowCell, 0.0), vec2(2.0, 1.0));",
            "}",
            "float spotShadowFactor1(vec3 worldPosition) {",
            "    if (uSpotShadowCount < 1.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix1, uSpotShadowAtlas, vec2(uSpotShadowCell1, 0.0), vec2(2.0, 1.0));",
            "}",
            "float pointShadowFactor(vec3 worldPosition) {",
            "    if (uHasPointShadow < 0.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition;",
            "    vec3 a = abs(direction);",
            "    vec2 cell;",
            "    mat4 matrix;",
            "    if (a.x >= a.y && a.x >= a.z) {",
            "        if (direction.x >= 0.0) { cell = vec2(0.0, 0.0); matrix = uPointShadowMatrix0; }",
            "        else { cell = vec2(1.0, 0.0); matrix = uPointShadowMatrix1; }",
            "    }",
            "    else if (a.y >= a.z) {",
            "        if (direction.y >= 0.0) { cell = vec2(2.0, 0.0); matrix = uPointShadowMatrix2; }",
            "        else { cell = vec2(0.0, 1.0); matrix = uPointShadowMatrix3; }",
            "    }",
            "    else {",
            "        if (direction.z >= 0.0) { cell = vec2(1.0, 1.0); matrix = uPointShadowMatrix4; }",
            "        else { cell = vec2(2.0, 1.0); matrix = uPointShadowMatrix5; }",
            "    }",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactor1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition1;",
            "    vec3 a = abs(direction);",
            "    int face = 0;",
            "    if (a.x >= a.y && a.x >= a.z) face = direction.x >= 0.0 ? 0 : 1;",
            "    else if (a.y >= a.z) face = direction.y >= 0.0 ? 2 : 3;",
            "    else face = direction.z >= 0.0 ? 4 : 5;",
            "    int cellIndex = 6 + face;",
            "    vec2 cell = vec2(mod(float(cellIndex), 4.0), floor(float(cellIndex) / 4.0));",
            "    mat4 matrix = uPointShadowMatrix6;",
            "    if (face == 1) matrix = uPointShadowMatrix7;",
            "    else if (face == 2) matrix = uPointShadowMatrix8;",
            "    else if (face == 3) matrix = uPointShadowMatrix9;",
            "    else if (face == 4) matrix = uPointShadowMatrix10;",
            "    else if (face == 5) matrix = uPointShadowMatrix11;",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactorCube(vec3 worldPosition) {",
            "    if (uHasPointShadowCube < 0.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition;",
            "    float normalized = length(toLight) / max(uPointShadowRange, 0.0001);",
            "    float stored = textureCube(uPointShadowCube, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "float pointShadowFactorCube1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition1;",
            "    float normalized = length(toLight) / max(uPointShadowRange1, 0.0001);",
            "    float stored = textureCube(uPointShadowCube1, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "void main() {",
            "    vec4 albedoSample = texture2D(uAlbedoMap, vUV);",
            "    vec3 albedo = albedoSample.rgb;",
            "    vec4 normalSample = texture2D(uNormalMap, vUV);",
            "    vec3 N = normalize(normalSample.xyz * 2.0 - 1.0);",
            "    float roughness = clamp(normalSample.a, 0.04, 1.0);",
            "    vec4 emissiveSample = texture2D(uEmissiveMap, vUV);",
            "    vec3 emissive = emissiveSample.rgb;",
            "    float metallic = clamp(emissiveSample.a, 0.0, 1.0);",
            "    vec2 ndc = vUV * 2.0 - 1.0;",
            "    vec3 ray = normalize(uCameraForward + uCameraRight * (ndc.x * uTanHalfFov * uAspect) + uCameraUp * (ndc.y * uTanHalfFov));",
            "    vec3 worldPosition = uCameraPosition;",
            "    vec3 V = -ray;",
            "    if (uHasDepth > 0.5) {",
            "        float depth = texture2D(uDepthMap, vUV).r;",
            "        vec4 clip = vec4(ndc, depth * 2.0 - 1.0, 1.0);",
            "        vec4 world = uInverseViewProjection * clip;",
            "        worldPosition = world.xyz / max(world.w, 0.0001);",
            "        V = normalize(uCameraPosition - worldPosition);",
            "    }",
            "    vec3 L = normalize(uLightDirection);",
            "    vec3 F0 = mix(vec3(0.04), albedo, metallic);",
            "    vec3 radiance = uLightColor * uLightIntensity;",
            "    if (uHasShadowMap > 0.5 && uHasDepth > 0.5) {",
            "        radiance *= shadowFactor(worldPosition);",
            "    }",
            "    vec3 color = evaluateLight(N, V, L, radiance, F0, albedo, metallic, roughness);",
            "    if (uHasDepth > 0.5) {",
            "        for (int i = 0; i < MAX_POINT_LIGHTS; ++i) {",
            "            if (uHasLightTileMap > 0.5) {",
            "                ivec2 tile = ivec2(gl_FragCoord.xy / uTileSize);",
            "                vec4 tileMask = texture2D(uLightTileMap, (vec2(tile) + 0.5) / uLightTileMapSize);",
            "                float packed;",
            "                if (i < 8) packed = tileMask.r;",
            "                else if (i < 16) packed = tileMask.g;",
            "                else if (i < 24) packed = tileMask.b;",
            "                else packed = tileMask.a;",
            "                int bitIndex = i - (i / 8) * 8;",
            "                float packed255 = floor(packed * 255.0 + 0.5);",
            "                float bitValue = mod(floor(packed255 / exp2(float(bitIndex))), 2.0);",
            "                if (bitValue < 0.5) continue;",
            "            }",
            "            if (i >= int(uPointLightCount)) break;",
            "            vec3 toLight = uPointLightPositions[i].xyz - worldPosition;",
            "            float distanceToLight = length(toLight);",
            "            vec3 lightDir = toLight / max(distanceToLight, 0.0001);",
            "            float range = uPointLightParams[i].x;",
            "            float intensity = uPointLightParams[i].y;",
            "            float attenuation = clamp(1.0 - distanceToLight / max(range, 0.0001), 0.0, 1.0);",
            "            attenuation = attenuation * attenuation / max(distanceToLight * distanceToLight, 0.0001);",
            "            if (uPointLightDirections[i].w > 0.5) {",
            "                vec3 spotDirection = normalize(-uPointLightDirections[i].xyz);",
            "                float theta = dot(lightDir, spotDirection);",
            "                float spot = clamp((theta - uPointLightParams[i].w) / max(uPointLightParams[i].z - uPointLightParams[i].w, 0.0001), 0.0, 1.0);",
            "                attenuation *= spot;",
            "            }",
            "            if (uHasSpotShadow > 0.5 && i == int(uSpotShadowLightIndex)) attenuation *= spotShadowFactor(worldPosition);",
            "            if (uHasPointShadowCube > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactorCube(worldPosition);",
"            else if (uHasPointShadow > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactor(worldPosition);",
            "            if (uHasPointShadowCube1 > 0.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactorCube1(worldPosition);",
"            else if (uPointShadowCount > 1.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactor1(worldPosition);",
            "            color += evaluateLight(N, V, lightDir, uPointLightColors[i].xyz * intensity * attenuation, F0, albedo, metallic, roughness);",
            "        }",
            "    }",
            "    float ao = uHasAOMap > 0.5 ? texture2D(uAOMap, vUV).r : 1.0;",
            "    color += emissive + albedo * uAmbient * ao;",
            "    gl_FragColor = vec4(color, 1.0);",
            "}"
        ]).join("\n");
    }

    /**
     * G-buffer debug visualization.
     *
     * uMode: 0 albedo, 1 normal (encoded), 2 depth (linearized), 3 lighting
     * factor (albedo * N dot L), 4 emissive.
     */
    public static function gbufferDebugFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uAlbedoMap;",
            "uniform sampler2D uNormalMap;",
            "uniform sampler2D uEmissiveMap;",
            "uniform sampler2D uDepthMap;",
            "uniform float uMode;",
            "uniform float uHasDepthMap;",
            "uniform float uNear;",
            "uniform float uFar;",
            "uniform float uDepthScale;",
            "uniform vec3 uLightDirection;",
            "void main() {",
            "    vec4 albedoSample = texture2D(uAlbedoMap, vUV);",
            "    vec4 normalSample = texture2D(uNormalMap, vUV);",
            "    vec4 emissiveSample = texture2D(uEmissiveMap, vUV);",
            "    vec3 color;",
            "    if (uMode < 0.5) {",
            "        color = albedoSample.rgb;",
            "    }",
            "    else if (uMode < 1.5) {",
            "        color = normalSample.xyz;",
            "    }",
            "    else if (uMode < 2.5) {",
            "        if (uHasDepthMap < 0.5) {",
            "            color = vec3(1.0, 0.0, 1.0);",
            "        }",
            "        else {",
            "            float depth = texture2D(uDepthMap, vUV).r;",
            "            float z = depth * 2.0 - 1.0;",
            "            float linearDepth = (2.0 * uNear * uFar) / max(uFar + uNear - z * (uFar - uNear), 0.0001);",
            "            color = vec3(clamp(linearDepth / max(uDepthScale, 0.0001), 0.0, 1.0));",
            "        }",
            "    }",
            "    else if (uMode < 3.5) {",
            "        vec3 N = normalize(normalSample.xyz * 2.0 - 1.0);",
            "        float ndl = max(dot(N, normalize(uLightDirection)), 0.0);",
            "        color = albedoSample.rgb * ndl;",
            "    }",
            "    else {",
            "        color = emissiveSample.rgb;",
            "    }",
            "    gl_FragColor = vec4(color, 1.0);",
            "}"
        ].join("\n");
    }

    public static function gbufferFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "uniform vec4 uBaseColor;",
            "uniform float uMetallic;",
            "uniform float uRoughness;",
            "uniform vec3 uEmissive;",
            "void main() {",
            "    gl_FragData[0] = vec4(uBaseColor.rgb, 1.0);",
            "    gl_FragData[1] = vec4(normalize(vNormal) * 0.5 + 0.5, uRoughness);",
            "    gl_FragData[2] = vec4(uEmissive, uMetallic);",
            "}"
        ].join("\n");
    }

    public static function brightPassFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uColorMap;",
            "uniform float uThreshold;",
            "void main() {",
            "    vec3 color = texture2D(uColorMap, vUV).rgb;",
            "    float luma = max(color.r, max(color.g, color.b));",
            "    float contribution = max(luma - uThreshold, 0.0) / max(luma, 0.0001);",
            "    gl_FragColor = vec4(color * contribution, 1.0);",
            "}"
        ].join("\n");
    }

    public static function blurFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uColorMap;",
            "uniform vec2 uTexelSize;",
            "uniform vec2 uDirection;",
            "void main() {",
            "    vec2 offset = uTexelSize * uDirection;",
            "    vec3 color = texture2D(uColorMap, vUV).rgb * 0.227027;",
            "    color += texture2D(uColorMap, vUV + offset * 1.384615).rgb * 0.316216;",
            "    color += texture2D(uColorMap, vUV - offset * 1.384615).rgb * 0.316216;",
            "    color += texture2D(uColorMap, vUV + offset * 3.230769).rgb * 0.070270;",
            "    color += texture2D(uColorMap, vUV - offset * 3.230769).rgb * 0.070270;",
            "    gl_FragColor = vec4(color, 1.0);",
            "}"
        ].join("\n");
    }

    public static function bloomCompositeFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uSceneMap;",
            "uniform sampler2D uBloomMap;",
            "uniform float uBloomIntensity;",
            "void main() {",
            "    vec3 scene = texture2D(uSceneMap, vUV).rgb;",
            "    vec3 bloom = texture2D(uBloomMap, vUV).rgb;",
            "    gl_FragColor = vec4(scene + bloom * uBloomIntensity, 1.0);",
            "}"
        ].join("\n");
    }

    public static function fxaaFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uColorMap;",
            "uniform vec2 uTexelSize;",
            "float luma(vec3 color) {",
            "    return dot(color, vec3(0.299, 0.587, 0.114));",
            "}",
            "void main() {",
            "    vec3 center = texture2D(uColorMap, vUV).rgb;",
            "    vec3 north = texture2D(uColorMap, vUV + vec2(0.0, uTexelSize.y)).rgb;",
            "    vec3 south = texture2D(uColorMap, vUV - vec2(0.0, uTexelSize.y)).rgb;",
            "    vec3 east = texture2D(uColorMap, vUV + vec2(uTexelSize.x, 0.0)).rgb;",
            "    vec3 west = texture2D(uColorMap, vUV - vec2(uTexelSize.x, 0.0)).rgb;",
            "    float centerLuma = luma(center);",
            "    float minLuma = min(centerLuma, min(min(luma(north), luma(south)), min(luma(east), luma(west))));",
            "    float maxLuma = max(centerLuma, max(max(luma(north), luma(south)), max(luma(east), luma(west))));",
            "    float contrast = maxLuma - minLuma;",
            "    if (contrast < 0.08) {",
            "        gl_FragColor = vec4(center, 1.0);",
            "        return;",
            "    }",
            "    vec3 average = (north + south + east + west) * 0.25;",
            "    gl_FragColor = vec4(mix(center, average, 0.35), 1.0);",
            "}"
        ].join("\n");
    }

    public static function shadowVertex():String {
        return [
            "attribute vec3 position;",
            "uniform mat4 modelMatrix;",
            "uniform mat4 lightViewProjection;",
            "void main() {",
            "    gl_Position = lightViewProjection * modelMatrix * vec4(position, 1.0);",
            "}"
        ].join("\n");
    }

    public static function shadowFragment():String {
        return [
            "void main() {",
            "    gl_FragColor = vec4(1.0);",
            "}"
        ].join("\n");
    }


    /** Writes the linear light distance (normalized by range) into a color
     *  target so a hardware cube map can be sampled without per-face
     *  matrices. Used to render point-light shadows into a cube face. */
    public static function shadowDistanceVertex():String {
        return [
            "attribute vec3 position;",
            "uniform mat4 modelMatrix;",
            "uniform mat4 lightViewProjection;",
            "varying vec3 vWorldPosition;",
            "void main() {",
            "    vec4 world = modelMatrix * vec4(position, 1.0);",
            "    vWorldPosition = world.xyz;",
            "    gl_Position = lightViewProjection * world;",
            "}"
        ].join("\n");
    }

    public static function shadowDistanceFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "uniform vec3 uLightPosition;",
            "uniform float uRange;",
            "void main() {",
            "    gl_FragColor = vec4(length(vWorldPosition - uLightPosition) / max(uRange, 0.0001), 0.0, 0.0, 1.0);",
            "}"
        ].join("\n");
    }

    public static function gbufferAlbedoFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "uniform vec4 uBaseColor;",
            "void main() {",
            "    gl_FragColor = vec4(uBaseColor.rgb, 1.0);",
            "}"
        ].join("\n");
    }

    public static function gbufferNormalFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "uniform float uRoughness;",
            "void main() {",
            "    gl_FragColor = vec4(normalize(vNormal) * 0.5 + 0.5, uRoughness);",
            "}"
        ].join("\n");
    }

    public static function gbufferEmissiveFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec2 vUV;",
            "uniform vec3 uEmissive;",
            "uniform float uMetallic;",
            "void main() {",
            "    gl_FragColor = vec4(uEmissive, uMetallic);",
            "}"
        ].join("\n");
    }

    public static function presentFragment():String {
        return [
            "varying vec2 vUV;",
            "uniform sampler2D uColorMap;",
            "void main() {",
            "    gl_FragColor = texture2D(uColorMap, vUV);",
            "}"
        ].join("\n");
    }
