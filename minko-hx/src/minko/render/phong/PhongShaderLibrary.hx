package minko.render.phong;

/**
 * GLSL sources for the forward Blinn-Phong path.
 *
 * Sources intentionally do not contain "#version": minko Shader prepends the
 * backend-specific version (100 for WebGL, 120 for HL/OpenGL).
 */
class PhongShaderLibrary {
    public static function forwardVertex():String {
        return [
            "attribute vec3 position;",
            "attribute vec3 normal;",
            "attribute vec2 uv;",
            "attribute vec4 tangent;",
            "uniform mat4 modelMatrix;",
            "uniform mat4 viewMatrix;",
            "uniform mat4 projectionMatrix;",
            "uniform mat4 normalMatrix;",
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec3 vTangent;",
            "varying float vHandedness;",
            "varying vec2 vUV;",
            "void main() {",
            "    vec4 world = modelMatrix * vec4(position, 1.0);",
            "    vWorldPosition = world.xyz;",
            "    vNormal = normalize((normalMatrix * vec4(normal, 0.0)).xyz);",
            "    vTangent = normalize((normalMatrix * vec4(tangent.xyz, 0.0)).xyz);",
            "    vHandedness = tangent.w;",
            "    vUV = uv;",
            "    gl_Position = projectionMatrix * viewMatrix * world;",
            "}"
        ].join("\n");
    }

    public static function forwardFragment():String {
        return [
            "varying vec3 vWorldPosition;",
            "varying vec3 vNormal;",
            "varying vec3 vTangent;",
            "varying float vHandedness;",
            "varying vec2 vUV;",
            "uniform vec3 uCameraPosition;",
            "uniform vec4 uDiffuse;",
            "uniform vec3 uSpecular;",
            "uniform float uShininess;",
            "uniform vec3 uAmbient;",
            "uniform vec3 uEmissive;",
            "uniform float uAlpha;",
            "uniform sampler2D uDiffuseMap;",
            "uniform float uHasDiffuseMap;",
            "uniform sampler2D uSpecularMap;",
            "uniform float uHasSpecularMap;",
            "uniform sampler2D uNormalMap;",
            "uniform float uHasNormalMap;",
            "uniform vec3 uLightDirection;",
            "uniform vec3 uLightColor;",
            "uniform float uLightIntensity;",
            "uniform sampler2D uShadowMap;",
            "uniform mat4 uLightViewProjection;",
            "uniform float uHasShadowMap;",
            "uniform float uShadowTexelSize;",
            "uniform float uSoftShadows;",
            "uniform float uLightSize;",
            "uniform sampler2D uSpotShadowAtlas;",
            "uniform mat4 uSpotShadowMatrix;",
            "uniform float uSpotShadowLightIndex;",
            "uniform float uSpotShadowCell;",
            "uniform float uSpotShadowCount;",
            "uniform float uSpotShadowLightIndex1;",
            "uniform float uSpotShadowCell1;",
            "uniform mat4 uSpotShadowMatrix1;",
            "uniform float uHasSpotShadow;",
            "uniform sampler2D uPointShadowAtlas;",
            "uniform mat4 uPointShadowMatrix0;",
            "uniform mat4 uPointShadowMatrix1;",
            "uniform mat4 uPointShadowMatrix2;",
            "uniform mat4 uPointShadowMatrix3;",
            "uniform mat4 uPointShadowMatrix4;",
            "uniform mat4 uPointShadowMatrix5;",
            "uniform mat4 uPointShadowMatrix6;",
            "uniform mat4 uPointShadowMatrix7;",
            "uniform mat4 uPointShadowMatrix8;",
            "uniform mat4 uPointShadowMatrix9;",
            "uniform mat4 uPointShadowMatrix10;",
            "uniform mat4 uPointShadowMatrix11;",
            "uniform float uPointShadowCount;",
            "uniform float uPointShadowLightIndex1;",
            "uniform vec3 uPointShadowPosition1;",
            "uniform float uPointShadowRange1;",
            "uniform vec3 uPointShadowPosition;",
            "uniform float uPointShadowRange;",
            "uniform float uPointShadowLightIndex;",
            "uniform float uHasPointShadow;",
            "uniform samplerCube uPointShadowCube;",
            "uniform samplerCube uPointShadowCube1;",
            "uniform float uHasPointShadowCube;",
            "uniform float uHasPointShadowCube1;",
            "#define MAX_POINT_LIGHTS 8",
            "uniform float uPointLightCount;",
            "uniform vec4 uPointLightPositions[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightColors[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightParams[MAX_POINT_LIGHTS];",
            "uniform vec4 uPointLightDirections[MAX_POINT_LIGHTS];",
            "float shadowFactor(vec3 worldPosition) {",
            "    if (uHasShadowMap < 0.5) return 1.0;",
            "    vec4 lightPosition = uLightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 uv = projected.xy * 0.5 + 0.5;",
            "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float occluder = texture2D(uShadowMap, uv).r;",
            "    float bias = 0.0015;",
            "    return depth - bias > occluder ? 0.35 : 1.0;",
            "}",
            "float shadowAt(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 uv = projected.xy * 0.5 + 0.5;",
            "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float radius = 1.0;",
            "    if (uSoftShadows > 0.5) {",
            "        float blockerSum = 0.0;",
            "        float blockers = 0.0;",
            "        for (int by = -2; by <= 2; ++by) {",
            "            for (int bx = -2; bx <= 2; ++bx) {",
            "                vec2 blockerUV = uv + vec2(float(bx), float(by)) * uShadowTexelSize;",
            "                if (blockerUV.x < 0.0 || blockerUV.x > 1.0 || blockerUV.y < 0.0 || blockerUV.y > 1.0) continue;",
            "                float occluder = texture2D(shadowMap, blockerUV).r;",
            "                if (depth - bias > occluder) {",
            "                    blockerSum += occluder;",
            "                    blockers += 1.0;",
            "                }",
            "            }",
            "        }",
            "        if (blockers > 0.5) {",
            "            float blockerDepth = blockerSum / blockers;",
            "            radius = clamp((depth - blockerDepth) * uLightSize * 100.0, 1.0, 8.0);",
            "        }",
            "    }",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = uv + vec2(float(x), float(y)) * uShadowTexelSize * radius;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {",
            "                result += 1.0;",
            "                continue;",
            "            }",
            "            float sampleOccluder = texture2D(shadowMap, sampleUV).r;",
            "            result += depth - bias > sampleOccluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float shadowAtAtlas(vec3 worldPosition, mat4 lightViewProjection, sampler2D shadowMap, vec2 cell, vec2 grid) {",
            "    vec4 lightPosition = lightViewProjection * vec4(worldPosition, 1.0);",
            "    vec3 projected = lightPosition.xyz / max(lightPosition.w, 0.0001);",
            "    vec2 uv = projected.xy * 0.5 + 0.5;",
            "    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;",
            "    float depth = projected.z * 0.5 + 0.5;",
            "    float bias = 0.0015;",
            "    float result = 0.0;",
            "    for (int y = -1; y <= 1; ++y) {",
            "        for (int x = -1; x <= 1; ++x) {",
            "            vec2 sampleUV = uv + vec2(float(x), float(y)) * uShadowTexelSize;",
            "            if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) { result += 1.0; continue; }",
            "            float occluder = texture2D(shadowMap, (sampleUV + cell) / grid).r;",
            "            result += depth - bias > occluder ? 0.35 : 1.0;",
            "        }",
            "    }",
            "    return result / 9.0;",
            "}",
            "float spotShadowFactor(vec3 worldPosition) {",
            "    if (uHasSpotShadow < 0.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix, uSpotShadowAtlas, vec2(uSpotShadowCell, 0.0), vec2(2.0, 1.0));",
            "}",
            "float spotShadowFactor1(vec3 worldPosition) {",
            "    if (uSpotShadowCount < 1.5) return 1.0;",
            "    return shadowAtAtlas(worldPosition, uSpotShadowMatrix1, uSpotShadowAtlas, vec2(uSpotShadowCell1, 0.0), vec2(2.0, 1.0));",
            "}",
            "float pointShadowFactor(vec3 worldPosition) {",
            "    if (uHasPointShadow < 0.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition;",
            "    vec3 a = abs(direction);",
            "    vec2 cell;",
            "    mat4 matrix;",
            "    if (a.x >= a.y && a.x >= a.z) {",
            "        if (direction.x >= 0.0) { cell = vec2(0.0, 0.0); matrix = uPointShadowMatrix0; }",
            "        else { cell = vec2(1.0, 0.0); matrix = uPointShadowMatrix1; }",
            "    }",
            "    else if (a.y >= a.z) {",
            "        if (direction.y >= 0.0) { cell = vec2(2.0, 0.0); matrix = uPointShadowMatrix2; }",
            "        else { cell = vec2(0.0, 1.0); matrix = uPointShadowMatrix3; }",
            "    }",
            "    else {",
            "        if (direction.z >= 0.0) { cell = vec2(1.0, 1.0); matrix = uPointShadowMatrix4; }",
            "        else { cell = vec2(2.0, 1.0); matrix = uPointShadowMatrix5; }",
            "    }",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactor1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 direction = worldPosition - uPointShadowPosition1;",
            "    vec3 a = abs(direction);",
            "    int face = 0;",
            "    if (a.x >= a.y && a.x >= a.z) face = direction.x >= 0.0 ? 0 : 1;",
            "    else if (a.y >= a.z) face = direction.y >= 0.0 ? 2 : 3;",
            "    else face = direction.z >= 0.0 ? 4 : 5;",
            "    int cellIndex = 6 + face;",
            "    vec2 cell = vec2(mod(float(cellIndex), 4.0), floor(float(cellIndex) / 4.0));",
            "    mat4 matrix = uPointShadowMatrix6;",
            "    if (face == 1) matrix = uPointShadowMatrix7;",
            "    else if (face == 2) matrix = uPointShadowMatrix8;",
            "    else if (face == 3) matrix = uPointShadowMatrix9;",
            "    else if (face == 4) matrix = uPointShadowMatrix10;",
            "    else if (face == 5) matrix = uPointShadowMatrix11;",
            "    return shadowAtAtlas(worldPosition, matrix, uPointShadowAtlas, cell, vec2(4.0, 3.0));",
            "}",
            "float pointShadowFactorCube(vec3 worldPosition) {",
            "    if (uHasPointShadowCube < 0.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition;",
            "    float normalized = length(toLight) / max(uPointShadowRange, 0.0001);",
            "    float stored = textureCube(uPointShadowCube, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "float pointShadowFactorCube1(vec3 worldPosition) {",
            "    if (uPointShadowCount < 1.5) return 1.0;",
            "    vec3 toLight = worldPosition - uPointShadowPosition1;",
            "    float normalized = length(toLight) / max(uPointShadowRange1, 0.0001);",
            "    float stored = textureCube(uPointShadowCube1, toLight).r;",
            "    return normalized - 0.02 <= stored ? 1.0 : 0.06;",
            "}",
            "void main() {",
            "    vec3 N = normalize(vNormal);",
            "    if (uHasNormalMap > 0.5 && length(vTangent) > 0.0001) {",
            "        vec3 T = normalize(vTangent - N * dot(N, vTangent));",
            "        vec3 B = cross(N, T) * vHandedness;",
            "        mat3 TBN = mat3(T, B, N);",
            "        vec3 sampledNormal = texture2D(uNormalMap, vUV).xyz * 2.0 - 1.0;",
            "        N = normalize(TBN * sampledNormal);",
            "    }",
            "    vec3 V = normalize(uCameraPosition - vWorldPosition);",
            "    vec3 baseColor = uDiffuse.rgb;",
            "    if (uHasDiffuseMap > 0.5) {",
            "        baseColor *= texture2D(uDiffuseMap, vUV).rgb;",
            "    }",
            "    vec3 specularColor = uSpecular;",
            "    if (uHasSpecularMap > 0.5) {",
            "        specularColor *= texture2D(uSpecularMap, vUV).rgb;",
            "    }",
            "    vec3 color = uAmbient * baseColor;",
            "    vec3 L = normalize(-uLightDirection);",
            "    float NdotL = max(dot(N, L), 0.0);",
            "    vec3 H = normalize(L + V);",
            "    float specular = pow(max(dot(N, H), 0.0), max(uShininess, 1.0));",
            "    vec3 radiance = uLightColor * uLightIntensity * shadowFactor(vWorldPosition);",
            "    color += radiance * (baseColor * NdotL + specularColor * specular);",
            "    for (int i = 0; i < MAX_POINT_LIGHTS; ++i) {",
            "        if (i >= int(uPointLightCount)) break;",
            "        vec3 toLight = uPointLightPositions[i].xyz - vWorldPosition;",
            "        float distanceToLight = length(toLight);",
            "        vec3 lightDir = toLight / max(distanceToLight, 0.0001);",
            "        float range = uPointLightParams[i].x;",
            "        float intensity = uPointLightParams[i].y;",
            "        float attenuation = clamp(1.0 - distanceToLight / max(range, 0.0001), 0.0, 1.0);",
            "        attenuation = attenuation * attenuation / max(distanceToLight * distanceToLight, 0.0001);",
            "        if (uPointLightDirections[i].w > 0.5) {",
            "            vec3 spotDirection = normalize(-uPointLightDirections[i].xyz);",
            "            float theta = dot(lightDir, spotDirection);",
            "            float spot = clamp((theta - uPointLightParams[i].w) / max(uPointLightParams[i].z - uPointLightParams[i].w, 0.0001), 0.0, 1.0);",
            "            attenuation *= spot;",
            "        }",
            "        float pointNdotL = max(dot(N, lightDir), 0.0);",
            "        vec3 pointH = normalize(lightDir + V);",
            "        float pointSpecular = pow(max(dot(N, pointH), 0.0), max(uShininess, 1.0));",
            "        if (uSpotShadowCount > 0.5 && i == int(uSpotShadowLightIndex)) attenuation *= spotShadowFactor(vWorldPosition);",
            "        if (uSpotShadowCount > 1.5 && i == int(uSpotShadowLightIndex1)) attenuation *= spotShadowFactor1(vWorldPosition);",
            "        if (uHasPointShadowCube > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactorCube(vWorldPosition);",
"        else if (uHasPointShadow > 0.5 && i == int(uPointShadowLightIndex)) attenuation *= pointShadowFactor(vWorldPosition);",
            "        if (uHasPointShadowCube1 > 0.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactorCube1(vWorldPosition);",
"        else if (uPointShadowCount > 1.5 && i == int(uPointShadowLightIndex1)) attenuation *= pointShadowFactor1(vWorldPosition);",
            "        color += uPointLightColors[i].xyz * intensity * attenuation",
            "            * (baseColor * pointNdotL + specularColor * pointSpecular);",
            "    }",
            "    color += uEmissive;",
            "    gl_FragColor = vec4(color, uAlpha);",
            "}"
        ].join("\n");
    }
}